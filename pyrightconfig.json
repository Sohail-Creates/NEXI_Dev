{
  "include": ["01_central_server", "06_enrollment_service"],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.*",
    "venv",
    ".venv",
    ".env",
    "**/build",
    "**/dist",
    "02_vision_service",
    "03_audio_service",
    "04_tts_service",
