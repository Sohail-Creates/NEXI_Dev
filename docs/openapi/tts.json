    "/config/set_voice": {
      "post": {
        "description": "Set the default voice for synthesis with intelligent speaker switching.\n\nOPTIMIZATION: Uses speaker manager to intelligently:\n- Load new speaker\n- Unload old default speaker (frees memory)\n- Keep other speakers in idle state (saves resources)\n\nSubsequent /speak requests will use this voice unless overridden.\nThread-safe with atomic update to SERVICE_CONFIG.\n\nArgs:\n    voice_id: Voice to set as default (e.g., \"jenny\", \"shahid\")",
        "operationId": "set_voice_config_set_voice_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpeechRequest"
              }
            }
