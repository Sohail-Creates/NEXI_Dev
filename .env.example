# NEXI Production Readiness Configuration Template
# Copy this file to .env and configure for your deployment
# Usage: source .env  (Linux/Mac) or copy values to your environment

# ═══════════════════════════════════════════════════════════════════════════════
# SERVICE URLS - Configure if deploying across multiple machines
# Default: localhost:8000-8006 (local development)
# ═══════════════════════════════════════════════════════════════════════════════

# Central Orchestrator
CENTRAL_SERVER_URL=http://localhost:8000

# Microservices
VISION_SERVICE_URL=http://localhost:8001
AUDIO_SERVICE_URL=http://localhost:8002
TTS_SERVICE_URL=http://localhost:8003
TEACHME_SERVICE_URL=http://localhost:8004
ENROLLMENT_SERVICE_URL=http://localhost:8005
LLM_SERVICE_URL=http://localhost:8006

# Example multi-machine deployment:
# CENTRAL_SERVER_URL=http://central-server:8000
# VISION_SERVICE_URL=http://vision-gpu-1:8001
# LLM_SERVICE_URL=http://llm-gpu-2:8006
# etc.

# ═══════════════════════════════════════════════════════════════════════════════
# LLM OPTIMIZATION - Tune performance vs quality trade-offs
# ═══════════════════════════════════════════════════════════════════════════════

# Token limit - Lower = faster but shorter responses
# Supported: 64, 128, 256, 512  |  Recommended: 128 (default, optimized for speed)
LLM_MAX_RESPONSE_TOKENS=128

# Hard timeout for inference (seconds)
# If inference takes longer, automatically fallback to template response
# Supported: 5.0-30.0  |  Recommended: 15.0 (default, good for RPi4+)
LLM_INFERENCE_TIMEOUT=15.0

# Temperature - Controls response randomness (lower = faster, more deterministic)
# Range: 0.1-1.0  |  Recommended: 0.6 (default, good balance)
LLM_TEMPERATURE=0.6

# Top-P (nucleus sampling) - Probability mass for sampling
# Range: 0.5-1.0  |  Recommended: 0.85 (default)
LLM_TOP_P=0.85

# ═══════════════════════════════════════════════════════════════════════════════
# SECURITY & SECRETS
# ═══════════════════════════════════════════════════════════════════════════════

# TeachMe Service JWT Secret - Change this in production!
# If not set: Auto-generated with warning (development only)
# Best practice: 32+ character random string
TEACHME_JWT_SECRET=change-this-to-a-secure-secret-in-production

# JWT token expiry (hours)
# Recommended: 24 (one day)
JWT_EXPIRY_HOURS=24

# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# Users database location (JSON file)
# Recommended: /path/to/persistent/storage/users.json
# Default: Relative path 01_central_server/data/users.json
USERS_DB_PATH=01_central_server/data/users.json

# Cache TTL for user database (seconds)
# How long to keep user data in memory before re-reading from disk
# Recommended: 30 (default) - provides 50-100x speedup on cache hits
# Higher values = faster but stale data risk
CACHE_TTL_SECONDS=30

# ═══════════════════════════════════════════════════════════════════════════════
# ADVANCED - Circuit Breaker & Resilience
# ═══════════════════════════════════════════════════════════════════════════════

# Circuit breaker failure threshold
# Number of failures before circuit opens (fallback mode)
# Recommended: 3 (default)
CIRCUIT_BREAKER_THRESHOLD=3

# Circuit breaker recovery timeout (seconds)
# After circuit opens, wait this long before trying to recover
# Recommended: 30 (default)
CIRCUIT_BREAKER_TIMEOUT=30

# Service call retry attempts
# Number of times to retry failed service calls
# Recommended: 2 (default)
SERVICE_RETRY_ATTEMPTS=2

# Retry delay between attempts (seconds)
# Recommended: 1.0 (default)
SERVICE_RETRY_DELAY=1.0

# ═══════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT EXAMPLES
# ═══════════════════════════════════════════════════════════════════════════════

# Example 1: Local Development (Ubuntu/RPi)
# ─────────────────────────────────────────
# CENTRAL_SERVER_URL=http://localhost:8000
# VISION_SERVICE_URL=http://localhost:8001
# LLM_MAX_RESPONSE_TOKENS=128

# Example 2: Docker Containers
# ─────────────────────────────────────────
# CENTRAL_SERVER_URL=http://nexi-central:8000
# VISION_SERVICE_URL=http://nexi-vision:8001
# TTS_SERVICE_URL=http://nexi-tts:8003
# LLM_SERVICE_URL=http://nexi-llm:8006

# Example 3: Kubernetes Cluster
# ─────────────────────────────────────────
# CENTRAL_SERVER_URL=http://central.nexi.svc.cluster.local:8000
# VISION_SERVICE_URL=http://vision.nexi.svc.cluster.local:8001
# LLM_SERVICE_URL=http://llm.nexi.svc.cluster.local:8006
# (other services similarly)

# Example 4: Production Multi-GPU Setup
# ─────────────────────────────────────────
# CENTRAL_SERVER_URL=http://10.0.1.10:8000
# VISION_SERVICE_URL=http://10.0.1.11:8001       # GPU 1
# LLM_SERVICE_URL=http://10.0.1.12:8006          # GPU 2
# TTS_SERVICE_URL=http://10.0.1.13:8003          # GPU 3

# ═══════════════════════════════════════════════════════════════════════════════
# USAGE INSTRUCTIONS
# ═══════════════════════════════════════════════════════════════════════════════

# LINUX / MAC:
# 1. Copy this file: cp .env.example .env
# 2. Edit: nano .env (configure for your deployment)
# 3. Load into shell: source .env
# 4. Verify: echo $CENTRAL_SERVER_URL
# 5. Run services: python 01_central_server/main.py

# WINDOWS (PowerShell):
# 1. Copy this file: Copy-Item .env.example .env
# 2. Edit: notepad .env
# 3. Load via script:
#    $env:CENTRAL_SERVER_URL = "http://localhost:8000"
#    # ... (set other vars)
# 4. Verify: echo $env:CENTRAL_SERVER_URL
# 5. Run services: python 01_central_server/main.py

# DOCKER:
# 1. Pass via docker run: docker run --env-file .env nexi:latest
# 2. Or docker compose: docker-compose up (reads .env automatically)

# KUBERNETES:
# 1. Create ConfigMap: kubectl create configmap nexi-config --from-env-file=.env
# 2. Reference in Pod spec: envFrom: [{configMapRef: {name: nexi-config}}]

# ═══════════════════════════════════════════════════════════════════════════════
# VALIDATION
# ═══════════════════════════════════════════════════════════════════════════════

# After setting these variables, run:
#   python validation_optimizations.py

# Expected output:
#   ✓ ServiceConfig works correctly
#   ✓ All clients import and initialize correctly
#   ✓ Persistence caching works correctly
#   ✓ LLM client fallback responses functional
#   ✓ Context builder retry configuration present
#   ✓ ALL VALIDATION TESTS PASSED

# ═══════════════════════════════════════════════════════════════════════════════
# MONITORING
# ═══════════════════════════════════════════════════════════════════════════════

# Check service health:
#   curl http://localhost:8000/health          # Central Server
#   curl http://localhost:8001/health          # Vision Service
#   curl http://localhost:8006/health          # LLM Service
#   # (etc. for other services)

# Monitor cache effectiveness:
#   python -c "from persistence import get_cache_stats; print(get_cache_stats())"

# Follow logs:
#   tail -f logs/central_server.log

