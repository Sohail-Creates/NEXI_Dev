# ============================================================
# NEXI Robot - API Keys & Configuration
# Copy to .env and fill in your keys
# ============================================================

# LLM Service (OpenRouter) - REQUIRED
OpenRouter_API_Key=YOUR_OPENROUTER_KEY_HERE

# Audio Service (Groq) - REQUIRED
GROQ_API_KEY=YOUR_GROQ_KEY_HERE

# Audio Wake Word (Picovoice) - REQUIRED for wake-word
# Get free key at https://console.picovoice.ai/
PORCUPINE_ACCESS_KEY=YOUR_PORCUPINE_KEY_HERE
# Optional hardware overrides. Leave unset to use each OS default device.
# VISION_CAMERA_DEVICE=0
# AUDIO_INPUT_DEVICE=Microphone Array
# VISION_MODEL_CACHE_DIR=02_vision_service/models

# Direct-voice session ends after this much continuous silence
CONVERSATION_SILENCE_TIMEOUT_SECONDS=10
TEACHME_FOCUS_DEFER_SECONDS=0.25

# Optional: Custom model paths (auto-downloaded if not set)
# PIPER_MODELS_DIR=/app/models
# SIGLIP2_CACHE_DIR=/app/models/hf

# Service URLs (auto-discovered via Docker DNS)
# CENTRAL_SERVER_URL=https://central:8000
# VISION_SERVICE_URL=https://vision:8001
# AUDIO_SERVICE_URL=https://audio:8002
# TTS_SERVICE_URL=https://tts:8003
# TEACHME_SERVICE_URL=https://teachme:8004
# ENROLLMENT_SERVICE_URL=https://enrollment:8005
# LLM_SERVICE_URL=https://llm:8006

# Model download at startup (set false to skip)
DOWNLOAD_MODELS=true

# GPU support (requires nvidia-docker)
# NVIDIA_VISIBLE_DEVICES=all
OPENROUTER_MODEL=openai/gpt-4o-mini

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OPENROUTER_API_KEY_ENV=OpenRouter_API_Key

# Conversation-only cloud export (disabled until a receiver is configured)
CLOUD_SYNC_ENABLED=false
CLOUD_SYNC_BASE_URL=
CLOUD_SYNC_AUTH_HEADER=Authorization
CLOUD_SYNC_AUTH_TOKEN=
CLOUD_SYNC_TIMEOUT_SECONDS=15
CLOUD_SYNC_INTERVAL_SECONDS=86400
CLOUD_SYNC_RETRY_ATTEMPTS=3
CLOUD_SYNC_RETRY_INITIAL_DELAY_SECONDS=1
CLOUD_SYNC_RETRY_MAX_DELAY_SECONDS=30
CLOUD_SYNC_RETRY_BACKOFF=2
CLOUD_SYNC_SUPERVISOR_RETRY_SECONDS=60
CLOUD_SYNC_BATCH_SIZE=100

# Phase 9 transport. Generate LOCAL certificates with: python -m config.ssl_config --generate-local
# Default paths are config/certificates under the repository; deployment may override all three.
NEXI_TLS_ENABLED=true
NEXI_TLS_ALLOW_PLAINTEXT=false
# NEXI_TLS_CERT_FILE=/secure/tls/server.crt
# NEXI_TLS_KEY_FILE=/secure/tls/server.key
# NEXI_TLS_CA_FILE=/secure/tls/trusted-ca.crt

# Mandatory biometric encryption: supply a securely provisioned Fernet key OR key file.
ENABLE_ENCRYPTION=true
# NEXI_FERNET_KEY=
# NEXI_FERNET_KEY_FILE=/secure/biometric.key
# NEXI_FERNET_PREVIOUS_KEY=
# NEXI_FERNET_PREVIOUS_KEY_FILE=/secure/biometric-previous.key

# Required shared service and session credentials; never commit real values.
AUTH_ENFORCEMENT_ENABLED=true
# NEXI_INTERNAL_SERVICE_TOKEN=
# NEXI_INTERNAL_SERVICE_TOKEN_PREVIOUS=
# NEXI_JWT_SECRET=
# NEXI_JWT_SECRET_PREVIOUS=
NEXI_SESSION_TOKEN_EXPIRE_MINUTES=30
# OpenRouter_API_Key_PREVIOUS=
NEXI_LOG_REDACTION_ENABLED=true
